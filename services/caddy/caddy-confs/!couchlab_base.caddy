# the ! at the start of the filename indicates a base config
*.{$BASE_DOMAIN} {
	import /etc/caddy/caddy-confs/cloudflare_dns_challenge.caddy

	import /etc/caddy/caddy-confs/13ft.caddy 13ft 5000
	import /etc/caddy/caddy-confs/adguard_home.caddy adguard-home 3000
	import /etc/caddy/caddy-confs/forgejo.caddy forgejo-server 3000
	import /etc/caddy/caddy-confs/jellyfin.caddy {$BBG_IP} 8096
	import /etc/caddy/caddy-confs/metube.caddy metube 8081
	import /etc/caddy/caddy-confs/n8n.caddy {$BBG_IP} 5678
	import /etc/caddy/caddy-confs/omni_tools.caddy omni-tools 80
	import /etc/caddy/caddy-confs/open-speed-test.caddy openspeedtest 3000
	import /etc/caddy/caddy-confs/prometheus.caddy prometheus 9090
	import /etc/caddy/caddy-confs/grafana.caddy grafana 3000
	import /etc/caddy/caddy-confs/searxng.caddy searxng 8080
	import /etc/caddy/caddy-confs/syncthing.caddy fangbox host.docker.internal 8384
	import /etc/caddy/caddy-confs/syncthing.caddy bbg {$BBG_IP} 8384
	import /etc/caddy/caddy-confs/whoami.caddy traefik-whoami 80
	import /etc/caddy/caddy-confs/wud.caddy wud 3000
}
