@paperless-ngx host pngx.{$BASE_DOMAIN}
handle @paperless-ngx {
  import default-headers

  header {
    X-Frame-Options "SAMEORIGIN"
    X-Content-Type-Options "nosniff"
    X-XSS-Protection "0"
    Permissions-Policy "camera=(), microphone=()"

    Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src blob: data: 'self'; upgrade-insecure-requests"
  }

  reverse_proxy http://paperless-ngx:8000
}

@paperless-gpt host pgpt.{$BASE_DOMAIN}
handle @paperless-gpt {
  import default-headers
  import unsafe-csp

  reverse_proxy http://paperless-gpt:8080
}

@paperless-ai host pai.{$BASE_DOMAIN}
handle @paperless-ai {
  import default-headers

  reverse_proxy http://paperless-ai:3000
}
