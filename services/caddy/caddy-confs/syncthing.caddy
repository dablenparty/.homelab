@syncthing-fangbox host syncthing-fangbox.{$BASE_DOMAIN}
handle @syncthing-fangbox {
  import default-headers

  reverse_proxy https://{$FANGBOX_IP}:8384 {
    transport http {
      tls_insecure_skip_verify
    }
    header_up Host {upstream_hostport}
  }
}

@syncthing-bbg host syncthing-bbg.{$BASE_DOMAIN}
handle @syncthing-bbg {
  import default-headers

  reverse_proxy https://{$BBG_IP}:8384 {
    transport http {
      tls_insecure_skip_verify
    }
    header_up Host {upstream_hostport}
  }
}
